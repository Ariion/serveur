# =============================================================================
#  Variables d'environnement Vercel — LobeChat, mode serveur + base de données
# =============================================================================
#
#  Deux comptes isolés (aardesign / procomsolution), Postgres Neon,
#  auth Better Auth email+mot de passe, DeepSeek pour le texte, fal.ai pour
#  les images Flux.1.
#
#  Noms de variables vérifiés contre lobehub/lobe-chat v2.2.13 :
#    packages/env/src/{app,auth,file,llm,image}.ts
#
#  IMPORTANT — ordre des opérations
#  Le build Vercel exécute `bun run build:vercel`, qui enchaîne le build PUIS
#  la migration de la base (`db:migrate`). Les variables du bloc 1 doivent donc
#  être présentes AVANT le tout premier déploiement, sinon le build échoue sur
#  la migration.
#
#  Ce fichier est un MODÈLE. Ne remplis pas les valeurs ici et ne le commite
#  jamais rempli : saisis-les dans Vercel > Settings > Environment Variables.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Base de données  (obligatoire, avant le 1er déploiement)
# -----------------------------------------------------------------------------

# Chaîne de connexion Neon, onglet "Connection string", pooled connection.
# Format : postgres://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Ne PAS définir DATABASE_DRIVER avec Neon : le driver serverless
# (@neondatabase/serverless, sur WebSocket) est le comportement par défaut et
# c'est celui qui convient aux fonctions Vercel. `DATABASE_DRIVER=node` n'est
# à utiliser qu'avec un Postgres classique (Docker, RDS…).
# DATABASE_DRIVER=node

# Chiffre les clés API que vous saisissez dans l'interface LobeChat avant
# stockage en base. Génère-la avec ./scripts/generer-secrets.sh
# À NE JAMAIS CHANGER après le premier déploiement : les valeurs déjà
# chiffrées deviendraient illisibles.
KEY_VAULTS_SECRET=


# -----------------------------------------------------------------------------
# 2. Authentification  (obligatoire)
# -----------------------------------------------------------------------------

# Signe les cookies de session Better Auth. ./scripts/generer-secrets.sh
# La changer déconnecte les deux comptes (sans perte de données).
AUTH_SECRET=

# Paire de clés RSA RS256 au format JWKS, sur une seule ligne.
# ./scripts/generer-secrets.sh la génère aussi.
JWKS_KEY=

# >>> LE VERROU LE PLUS IMPORTANT DE CE DÉPLOIEMENT <<<
# Liste blanche des adresses autorisées à créer un compte. Sans elle, le site
# est en inscription ouverte : n'importe qui ayant l'URL peut se créer un
# compte sur votre instance. Avec exactement vos deux adresses, toute autre
# tentative d'inscription est rejetée (EMAIL_NOT_ALLOWED).
# Mets les deux adresses complètes, séparées par une virgule, sans espace.
# Un élément sans "@" serait interprété comme un DOMAINE entier — ne mets
# jamais "gmail.com" ici, cela autoriserait tout Gmail.
AUTH_ALLOWED_EMAILS=

# URL publique du site. Renseigne-la après le premier déploiement, avec ton
# domaine définitif (ou l'URL .vercel.app de production).
# Sans domaine personnalisé, Vercel la déduit seul ; avec un domaine
# personnalisé, elle est nécessaire pour que les liens et les cookies soient
# émis sur le bon hôte.
APP_URL=

# Aucun SSO n'est configuré : email + mot de passe uniquement, ce qui suffit
# pour deux comptes et évite un fournisseur d'identité tiers de plus.
# AUTH_SSO_PROVIDERS=

# Vérification de l'adresse email à l'inscription. Laisse à 0 : l'activer
# exige un serveur SMTP (bloc SMTP_*), et la liste blanche ci-dessus rend
# déjà impossible l'inscription d'un tiers.
# AUTH_EMAIL_VERIFICATION=0


# -----------------------------------------------------------------------------
# 3. Fournisseurs de modèles
# -----------------------------------------------------------------------------

# DeepSeek — texte et code.
DEEPSEEK_API_KEY=

# fal.ai — génération d'images Flux.1.
# fal.ai expose 5 modèles Flux dans LobeChat (flux/schnell, flux/krea,
# flux-kontext/dev, flux-pro/kontext, plus les modèles d'édition).
# Together AI n'expose AUCUN modèle image dans LobeChat : ne l'utilise pas
# pour les images. Voir DEPLOIEMENT.md §5.
FAL_API_KEY=

# LobeChat exige une valeur pour OPENAI_API_KEY dans son modèle .env amont,
# mais la variable est facultative en pratique. Laisse-la vide si tu n'as pas
# de compte OpenAI ; le fournisseur restera simplement désactivé.
# OPENAI_API_KEY=

# Nombre d'images générées par requête (1-20, défaut 4). À 1, chaque prompt
# coûte quatre fois moins cher chez fal.ai.
# AI_IMAGE_DEFAULT_IMAGE_NUM=1


# -----------------------------------------------------------------------------
# 4. Stockage objet S3  (requis pour les images générées et les pièces jointes)
# -----------------------------------------------------------------------------
#
#  Sans S3, la génération d'images et l'envoi de fichiers ne fonctionnent pas
#  en mode serveur : Vercel n'a pas de disque persistant.
#  Recommandé : Cloudflare R2 (pas de frais de sortie, compatible S3).
#
#  ATTENTION ISOLATION — les clés d'objets sont de la forme
#  `files/<horodatage>/<uuid>.<ext>` : elles ne contiennent PAS l'identifiant
#  du propriétaire. C'est la base de données qui décide qui voit quoi, pas le
#  bucket. Il faut donc que le bucket reste privé, sinon toute personne
#  connaissant une URL peut lire le fichier sans être authentifiée.
#  Concrètement : ne définis NI S3_SET_ACL NI S3_PUBLIC_DOMAIN (voir plus bas).

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Endpoint SANS le nom du bucket dans le chemin, et avec https://
S3_ENDPOINT=
# R2 : "auto". AWS : la région du bucket (eu-west-3…).
S3_REGION=auto

# --- Les deux variables à NE PAS définir ---------------------------------
#
# S3_SET_ACL=1 pose l'ACL "public-read" sur chaque objet écrit : toutes les
# images générées et tous les fichiers envoyés deviennent lisibles par
# quiconque possède l'URL, sans authentification.
# S3_SET_ACL=1                 <-- laisser commenté
#
# S3_PUBLIC_DOMAIN fait servir les fichiers par une URL publique permanente
# au lieu d'une URL signée à durée limitée.
# S3_PUBLIC_DOMAIN=...         <-- laisser commenté
#
# En laissant ces deux variables absentes, LobeChat sert les fichiers via des
# URLs pré-signées expirant après S3_PREVIEW_URL_EXPIRE_IN secondes
# (7200 par défaut), délivrées uniquement à l'utilisateur authentifié.
# S3_PREVIEW_URL_EXPIRE_IN=7200
# -------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# 5. Ce qu'il ne faut surtout PAS mettre
# -----------------------------------------------------------------------------
#
# ACCESS_CODE — le mode mot de passe partagé que tu voulais éviter. Bonne
# nouvelle : cette variable n'existe plus du tout dans LobeChat v2, elle a été
# entièrement retirée du code. Il n'y a donc rien à désactiver, et aucun
# risque de retomber dessus par erreur de configuration.
#
# NEXT_PUBLIC_SERVICE_MODE — n'existe plus non plus. En v2, c'est la simple
# présence de DATABASE_URL qui met l'application en mode serveur.
